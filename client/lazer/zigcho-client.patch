+
+            var profile = JsonConvert.DeserializeObject<APIUser>(json);
+
+            Assert.That(profile, Is.Not.Null);
+            Assert.Multiple(() =>
+            {
+                Assert.That(profile!.Statistics, Is.Not.Null);
+                Assert.That(profile.Statistics.IsRanked, Is.True);
