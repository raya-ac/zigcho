+// Copyright (c) ppy Pty Ltd <contact@ppy.sh>. Licensed under the MIT Licence.
+// See the LICENCE file in the official osu! source tree for full licence text.
+
+using System.Text;
+using NUnit.Framework;
+using osu.Game.Online.Metadata;
+using osu.Game.Users;
+
+namespace osu.Game.Online.Tests
+{
+    [TestFixture]
+    public class ZigchoPollingPresenceTest
+    {
+        [Test]
+        public void TestOnlineFriendsAreCopiedIntoFriendPresence()
+        {
+            var onlineFriends = OnlineMetadataClient.GetOnlineFriendIds(
+                new[] { 3, 4, 35 },
+                new[] { 4, 11 });
+
+            Assert.That(onlineFriends, Is.EquivalentTo(new[] { 4 }));
+            Assert.That(onlineFriends, Does.Not.Contain(11));
+        }
+
+        [Test]
+        public void TestOfflineRowsAreNotTreatedAsPresence()
+        {
+            var onlineUsers = OnlineMetadataClient.GetOnlineUserIds(new[]
+            {
+                (UserId: 3, Online: true),
+                (UserId: 4, Online: false),
+                (UserId: 35, Online: true),
+            });
+
+            Assert.That(onlineUsers, Is.EquivalentTo(new[] { 3, 35 }));
+        }
+
+        [Test]
+        public void TestRemoteActivityKeepsStatusDetailsAndBeatmap()
+        {
+            var activity = OnlineMetadataClient.CreatePollingActivity("playing", "fixture song", 75);
+
+            Assert.That(activity, Is.Not.Null);
+            Assert.That(activity!.GetStatus(), Is.EqualTo("playing"));
+            Assert.That(activity.GetDetails(), Is.EqualTo("fixture song"));
+            Assert.That(activity.GetBeatmapID(), Is.EqualTo(75));
+            Assert.That(activity.GetDetails(true), Is.Null);
+            Assert.That(activity.GetBeatmapID(true), Is.Null);
+            Assert.That(OnlineMetadataClient.CreatePollingActivity("offline", null, null), Is.Null);
+        }
+
+        [Test]
+        public void TestSubmittedActivityIsUtf8BoundedAndKeepsRuleset()
+        {
+            var activity = new UserActivity.InSoloGame
+            {
+                BeatmapID = 75,
+                BeatmapDisplayTitle = new string('あ', 100),
+                RulesetID = 2,
+                RulesetPlayingVerb = new string('p', 100),
+            };
+
+            var payload = OnlineMetadataClient.CreateActivityPayload(activity);
+
+            Assert.That(payload, Is.Not.Null);
+            Assert.That(Encoding.UTF8.GetByteCount(payload!.Value.Status), Is.LessThanOrEqualTo(80));
+            Assert.That(Encoding.UTF8.GetByteCount(payload.Value.Detail), Is.LessThanOrEqualTo(200));
+            Assert.That(payload.Value.BeatmapId, Is.EqualTo(75));
+            Assert.That(payload.Value.RulesetId, Is.EqualTo(2));
+            Assert.That(OnlineMetadataClient.CreateActivityPayload(null), Is.Null);
+
+            activity.BeatmapID = 0;
+            activity.RulesetID = 9;
+            payload = OnlineMetadataClient.CreateActivityPayload(activity);
+            Assert.That(payload!.Value.BeatmapId, Is.Null);
+            Assert.That(payload.Value.RulesetId, Is.Null);
+        }
+    }
+}
