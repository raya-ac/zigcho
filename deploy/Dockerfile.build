FROM rust:1.94.1-bookworm@sha256:6ae102bdbf528294bc79ad6e1fae682f6f7c2a6e6621506ba959f9685b308a55 AS rust

FROM debian:bookworm-slim@sha256:362e64223cc0da95422b3b13c045186fc0a81250e765d31c025fbddf257f6143

ARG ZIG_VERSION=0.16.0
ARG ZIG_SHA256=70e49664a74374b48b51e6f3fdfbf437f6395d42509050588bd49abe52ba3d00

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl gcc git libpq-dev libsqlite3-dev pkg-config xz-utils \
    && rm -rf /var/lib/apt/lists/*

COPY --from=rust /usr/local/cargo /usr/local/cargo
COPY --from=rust /usr/local/rustup /usr/local/rustup
ENV PATH=/usr/local/cargo/bin:$PATH \
    RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo

RUN curl --fail --location --silent --show-error \
        "https://ziglang.org/download/${ZIG_VERSION}/zig-x86_64-linux-${ZIG_VERSION}.tar.xz" \
        --output /tmp/zig.tar.xz \
    && echo "${ZIG_SHA256}  /tmp/zig.tar.xz" | sha256sum --check --strict \
    && mkdir /opt/zig \
    && tar --extract --xz --file /tmp/zig.tar.xz --strip-components=1 --directory /opt/zig \
    && ln -s /opt/zig/zig /usr/local/bin/zig \
    && rm /tmp/zig.tar.xz

WORKDIR /src
COPY . .

RUN zig build test \
    && zig build -Doptimize=ReleaseSafe \
    && zig build -Dpostgres=true -Doptimize=ReleaseSafe \
    && mkdir -p /out/tools /out/deploy/systemd /out/deploy/stunnel /out/deploy/certbot \
    && cp zig-out/bin/zigcho zig-out/bin/zigcho-import zig-out/bin/zigcho-import-archive zig-out/bin/zigcho-migrate-postgres /out/ \
    && strip --strip-all /out/zigcho /out/zigcho-import /out/zigcho-import-archive /out/zigcho-migrate-postgres \
    && cp src/pp_engine_version.txt /out/pp-engine-version \
    && cp tools/backup-postgres.sh tools/backup-postgres-object.sh tools/restore-postgres-drill.sh tools/activate-release.sh /out/tools/ \
    && cp deploy/systemd/zigcho.service deploy/systemd/zigcho-mirror-worker.service deploy/systemd/zigcho-postgres-backup.service deploy/systemd/zigcho-postgres-backup.timer deploy/systemd/zigcho-irc-tls.service /out/deploy/systemd/ \
    && cp deploy/stunnel/zigcho-irc.conf /out/deploy/stunnel/ \
    && cp deploy/certbot/zigcho-irc-certificate /out/deploy/certbot/
