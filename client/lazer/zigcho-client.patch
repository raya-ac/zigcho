+// Copyright (c) ppy Pty Ltd <contact@ppy.sh>. Licensed under the MIT Licence.
+// See the LICENCE file in the official osu! source tree for full licence text.
+
+using Newtonsoft.Json;
+using NUnit.Framework;
+using osu.Game.Online.Rooms;
+
+namespace osu.Game.Online.Tests
+{
+    [TestFixture]
+    public class ZigchoScoreResponseTest
+    {
+        [Test]
+        public void TestAchievementSubmissionResponseDeserialises()
+        {
+            const string response = """
+                                    {"id":60,"position":1,"achievement_unlocks":[
+                                      {"achievement_id":8,"achievement_mode":null,"cover_url":"","slug":"osu-skill-pass-8","title":"Absolution","description":"My god, you're full of stars!","user_id":4},
+                                      {"achievement_id":76,"achievement_mode":null,"cover_url":"","slug":"all-intro-hardrock","title":"Rock Around The Clock","description":"You can't stop the rock.","user_id":4},
+                                      {"achievement_id":161,"achievement_mode":null,"cover_url":"","slug":"kai-osu-pp-50","title":"osu 50pp","description":"set a ranked osu map worth at least 50pp.","user_id":4}
+                                    ]}
+                                    """;
+
+            var score = JsonConvert.DeserializeObject<MultiplayerScore>(response);
+
+            Assert.That(score, Is.Not.Null);
+            Assert.That(score!.ID, Is.EqualTo(60));
+            Assert.That(score.Position, Is.EqualTo(1));
+            Assert.That(score.AchievementUnlocks, Has.Length.EqualTo(3));
+            Assert.That(score.AchievementUnlocks[1].Slug, Is.EqualTo("all-intro-hardrock"));
+        }
+
+
+    }
+}
