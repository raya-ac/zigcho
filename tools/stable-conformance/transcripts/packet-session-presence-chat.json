{
  "schema": 1,
  "id": "packet-session-presence-chat",
  "category": "stable-packets",
  "description": "authenticated Stable session, presence, channel, social and chat packets replayed one client action at a time against mirrored isolated fixtures",
  "contract_sources": {
    "zigcho": ["src/protocol.zig", "src/bancho.zig"],
    "bancho_py": {
      "repository": "https://github.com/osuAkatsuki/bancho.py",
      "commit": "0651b54c66daa839c1bb3998e4f9a8d1173e144d",
      "handlers": "app/api/domains/cho.py",
      "codec": "app/packets.py"
    }
  },
  "known_reference_limitations": [
    {
      "client_packet": 98,
      "reference_commit": "0651b54c66daa839c1bb3998e4f9a8d1173e144d",
      "behavior": "the pinned reference iterates a set of unrestricted players, shadows the requester variable and enqueues the presence bundle onto the nondeterministic final member",
      "fixture_requirement": "the still-online peer requests packet 98 only after primary logout has been observed, as the final step of the final corpus scenario",
      "comparison": "complete mode statically attests the exact pinned shadowed-set handler; runtime fully checks Zigcho's requester response while the reference response body is explicitly unobservable and uncompared"
    }
  ],
  "registered_no_output": [
    {
      "client_packet": 79,
      "reason": "both implementations accept the preference without a response and expose no protocol readback; this transcript asserts only the exact empty response"
    }
  ],
  "baseline_evidence": [
    {
      "state": "primary public-channel membership",
      "before": ["peer-messages-before-join", "primary-confirms-not-joined"],
      "mutation": "join-public-channel",
      "after": ["send-public-message", "peer-observes-public-message"]
    },
    {
      "state": "primary away message and non-friend DM blocking",
      "before": ["peer-tests-clear-away-and-open-dm-baseline", "primary-receives-baseline-dm"],
      "mutations": ["set-away-message", "enable-nonfriend-dm-block"],
      "after": ["peer-tests-away-message", "peer-tests-block-policy", "primary-confirms-blocked-dm"]
    },
    {
      "state": "primary friend relation to peer",
      "before": ["friend-initial-readback"],
      "mutations": ["friend-add", "friend-remove"],
      "after": ["friend-add-readback", "friend-remove-readback"]
    }
  ],
  "mutates_state": true,
  "safety": {
    "production_allowed": false,
    "reason": "this case writes chat, direct-message and friend state, changes session preferences, then logs the fixture user out"
  },
  "fixture_contract": [
    "primary and peer are unrestricted, unsilenced Stable sessions with clean response queues",
    "primary and peer user ids, usernames, statistics and channel permissions represent the same logical fixture on both targets",
    "peer is online, has not blocked primary and permits direct messages from primary",
    "primary and peer start as non-friends so add, remove and non-friend-DM blocking have observable transitions",
    "primary starts with no away message and non-friend DM blocking disabled",
    "the configured public channel exists and is writable on both targets",
    "primary is not initially joined to the configured public channel and peer is already joined",
    "the actor is empty-polled immediately after public channel join and part so handler queue timing cannot leak into later chat checks",
    "packet 98 is the final request in the final manifest scenario so a bundle queued to an arbitrary reference session cannot contaminate a later poll",
    "the peer remains online after observing primary logout and must occur exactly once in Zigcho's returned presence bundle; the rest of the visible set is fixture-dependent",
    "user id variables are JSON integers, not numeric strings",
    "primary has been logged in for at least one second before the final logout packet"
  ],
  "requires": [
    "stable_primary_token",
    "stable_primary_user_id",
    "stable_primary_username",
    "stable_primary_password_md5",
    "stable_peer_token",
    "stable_peer_user_id",
    "stable_peer_username",
    "stable_public_channel"
  ],
  "session_bindings": [
    { "token": "stable_primary_token", "user_id": "stable_primary_user_id" },
    { "token": "stable_peer_token", "user_id": "stable_peer_user_id" }
