[Unit]
Description=zigcho PostgreSQL backup and restore verification
After=postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
Environment="ZIGCHO_BACKUP_DIR=/var/backups/zigcho"
Environment="ZIGCHO_POSTGRES_URL=dbname=zigcho"
Environment="ZIGCHO_POSTGRES_ADMIN_URL=dbname=postgres"
ExecStart=/opt/zigcho/current/tools/backup-postgres-object.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups/zigcho
