FROM rust:1.94.1-bookworm@sha256:6ae102bdbf528294bc79ad6e1fae682f6f7c2a6e6621506ba959f9685b308a55 AS rust

FROM debian:bookworm-slim@sha256:362e64223cc0da95422b3b13c045186fc0a81250e765d31c025fbddf257f6143

ARG ZIG_VERSION=0.16.0
ARG ZIG_SHA256=70e49664a74374b48b51e6f3fdfbf437f6395d42509050588bd49abe52ba3d00
ARG TEST_SCOPE=full
ARG INCLUDE_LEGACY_TOOLS=false

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl gcc git jq libpq-dev libsqlite3-dev pkg-config sqlite3 xz-utils \
    && rm -rf /var/lib/apt/lists/*

COPY --from=rust /usr/local/cargo /usr/local/cargo
COPY --from=rust /usr/local/rustup /usr/local/rustup
ENV PATH=/usr/local/cargo/bin:$PATH \
    RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo

RUN curl --fail --location --silent --show-error \
        "https://ziglang.org/download/${ZIG_VERSION}/zig-x86_64-linux-${ZIG_VERSION}.tar.xz" \
        --output /tmp/zig.tar.xz \
    && echo "${ZIG_SHA256}  /tmp/zig.tar.xz" | sha256sum --check --strict \
    && mkdir /opt/zig \
    && tar --extract --xz --file /tmp/zig.tar.xz --strip-components=1 --directory /opt/zig \
    && ln -s /opt/zig/zig /usr/local/bin/zig \
    && rm /tmp/zig.tar.xz

WORKDIR /src
COPY . .

RUN if [ "$TEST_SCOPE" = full ]; then \
        zig build test -Dcpu=baseline \
        && zig build test -Dcpu=baseline -Doptimize=ReleaseSafe; \
    elif [ "$TEST_SCOPE" != focused ] && [ "$TEST_SCOPE" != stable ] && [ "$TEST_SCOPE" != score-chart ]; then \
        echo "invalid TEST_SCOPE: $TEST_SCOPE" >&2; exit 1; \
    fi \
    && zig build -Dcpu=baseline -Dpostgres=false -Doptimize=ReleaseSafe \
    && ZIGCHO_SMOKE_PORT=18131 tools/stable-web-smoke.sh zig-out/bin/zigcho \
    && zig test src/anticheat_replay.zig -OReleaseSafe \
    && zig build -Dcpu=baseline -Dpostgres=true -Doptimize=ReleaseSafe \
    && mkdir -p /out/tools /out/deploy/systemd /out/deploy/stunnel /out/deploy/certbot \
    && cp zig-out/bin/zigcho zig-out/bin/zigcho-anticheat-host-smoke /out/ \
    && strip --strip-all /out/zigcho /out/zigcho-anticheat-host-smoke \
    && if [ "$INCLUDE_LEGACY_TOOLS" = true ]; then \
        zig build legacy-tools -Dcpu=baseline -Doptimize=ReleaseSafe \
        && cp zig-out/bin/zigcho-import zig-out/bin/zigcho-import-archive zig-out/bin/zigcho-migrate-postgres /out/ \
        && strip --strip-all /out/zigcho-import /out/zigcho-import-archive /out/zigcho-migrate-postgres; \
    elif [ "$INCLUDE_LEGACY_TOOLS" != false ]; then \
        echo "invalid INCLUDE_LEGACY_TOOLS: $INCLUDE_LEGACY_TOOLS" >&2; exit 1; \
    fi \
    && ! objdump -d /out/zigcho | grep -Eq '%zmm|%k[0-7]' \
    && cp src/pp_engine_version.txt /out/pp-engine-version \
    && cp tools/backup-postgres.sh tools/backup-postgres-object.sh tools/backup-transfer.sh tools/restore-postgres-drill.sh tools/rollback-release.sh tools/activate-release.sh tools/activate-hotfix.sh /out/tools/ \
    && cp deploy/systemd/zigcho.service deploy/systemd/zigcho-mirror-worker.service deploy/systemd/zigcho-postgres-backup.service deploy/systemd/zigcho-postgres-backup.timer deploy/systemd/zigcho-irc-tls.service /out/deploy/systemd/ \
    && cp deploy/stunnel/zigcho-irc.conf /out/deploy/stunnel/ \
    && cp deploy/certbot/zigcho-irc-certificate /out/deploy/certbot/
