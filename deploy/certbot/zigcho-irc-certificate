#!/bin/sh
set -eu

source_dir=/etc/letsencrypt/live/kai.ovh
target=/etc/stunnel/zigcho-irc.pem
temporary=$(mktemp /etc/stunnel/.zigcho-irc.pem.XXXXXX)
trap 'rm -f "$temporary"' EXIT HUP INT TERM

umask 077
cat "$source_dir/fullchain.pem" "$source_dir/privkey.pem" >"$temporary"
chown stunnel4:stunnel4 "$temporary"
chmod 0600 "$temporary"
mv -f "$temporary" "$target"
trap - EXIT HUP INT TERM

if systemctl is-enabled --quiet zigcho-irc-tls.service; then
    systemctl try-reload-or-restart zigcho-irc-tls.service
fi
