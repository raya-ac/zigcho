+
+using System.Collections.Generic;
+using System.Linq;
+using osu.Game.Rulesets.Mods;
+
+namespace osu.Game.Online.Leaderboards
+{
+    public static class ZigchoLeaderboardMods
+    {
+        public static bool UsesPerformanceOrder(IEnumerable<IMod> mods) => mods.Any(isNamespaceMod);
+
+        public static Mod[]? ResolveGameplayFilter(Mod[]? exactMods, IReadOnlyList<Mod> gameplayMods)
+        {
+            if (exactMods != null)
+                return exactMods;
+
+            var namespaceMods = gameplayMods.Where(isNamespaceMod).ToArray();
+            return namespaceMods.Length == 0 ? null : namespaceMods;
+        }
+
+        private static bool isNamespaceMod(IMod mod)
+        {
+            string acronym = mod.Acronym.ToString();
+            return acronym is "RX" or "AP";
+        }
+    }
+}
