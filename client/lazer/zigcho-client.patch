@@ -0,0 +1,43 @@
+// Copyright (c) ppy Pty Ltd <contact@ppy.sh>. Licensed under the MIT Licence.
+// See the LICENCE file in the repository root for full licence text.
+
+using NUnit.Framework;
+using osu.Game.Online.Leaderboards;
+using osu.Game.Rulesets.Mods;
+using osu.Game.Rulesets.Osu.Mods;
+
+namespace osu.Game.Tests
+{
+    [TestFixture]
+    public class ZigchoLeaderboardModsTest
+    {
+        [Test]
+        public void GameplayNamespaceIsSentWithoutMakingEveryGameplayModExact()
+        {
+            Mod[] gameplay = [new OsuModHidden(), new OsuModRelax()];
+            var resolved = ZigchoLeaderboardMods.ResolveGameplayFilter(null, gameplay);
+
+            Assert.That(resolved, Has.Length.EqualTo(1));
+            Assert.That(resolved![0].Acronym.ToString(), Is.EqualTo("RX"));
+            Assert.That(ZigchoLeaderboardMods.UsesPerformanceOrder(resolved), Is.True);
+        }
+
+        [Test]
+        public void ExplicitFilterIsKeptExact()
+        {
+            Mod[] exact = [new OsuModHidden(), new OsuModAutopilot()];
+            Mod[] gameplay = [new OsuModAutopilot()];
+
+            Assert.That(ZigchoLeaderboardMods.ResolveGameplayFilter(exact, gameplay), Is.SameAs(exact));
+        }
+
+        [Test]
+        public void VanillaGameplayKeepsCombinedBoard()
+        {
+            Mod[] gameplay = [new OsuModHidden()];
+
+            Assert.That(ZigchoLeaderboardMods.ResolveGameplayFilter(null, gameplay), Is.Null);
+            Assert.That(ZigchoLeaderboardMods.UsesPerformanceOrder(gameplay), Is.False);
+        }
+    }
+}
