+            var response = JsonConvert.DeserializeObject<APICreatedRoom>(responseJson);
+
+            Assert.That(response, Is.Not.Null);
+            Assert.That(response!.StartDate, Is.EqualTo(DateTimeOffset.Parse("2099-08-24T00:00:00Z")));
+            Assert.That(response.EndDate, Is.EqualTo(DateTimeOffset.Parse("2099-08-24T00:30:00Z")));
+            Assert.That(response.EndDate!.Value - response.StartDate!.Value, Is.EqualTo(TimeSpan.FromMinutes(30)));
+            Assert.That(response.MaxAttempts, Is.EqualTo(3));
+            Assert.That(response.UserScore, Is.Not.Null);
+            Assert.That(response.UserScore!.PlaylistItemAttempts, Has.Length.EqualTo(1));
+            Assert.That(response.MaxAttempts - response.UserScore.PlaylistItemAttempts.Sum(attempt => attempt.Attempts), Is.EqualTo(2));
+
+            var liveRoom = new Room();
+            liveRoom.CopyFrom(response);
+
+            Assert.That(liveRoom.EndDate, Is.Not.Null);
+            Assert.That(liveRoom.UserScore, Is.SameAs(response.UserScore));
+
+            var selectionTime = DateTimeOffset.Parse("2099-08-24T00:10:00Z");
+            var trackLength = TimeSpan.FromMinutes(3);
+            Assert.That(selectionTime.AddSeconds(30).Add(trackLength), Is.LessThan(liveRoom.EndDate!.Value));
+        }
+    }
+}
