+
+using osu.Game.Beatmaps;
+
+namespace osu.Game.Online.Leaderboards
+{
+    public static class ZigchoLeaderboardAvailability
+    {
+        public static bool IsAvailable(IBeatmapInfo? beatmap) => beatmap?.OnlineID > 0;
