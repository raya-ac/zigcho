{
  "schema": 1,
  "id": "account-policy",
  "category": "policy-matrix",
  "description": "restricted packet dispatch and silenced chat behavior, including Zigcho's intentional visible silence feedback",
  "mutates_state": true,
  "safety": {
    "production_allowed": false,
    "reason": "this case changes presence filters and session activity and attempts blocked chat and channel operations"
  },
  "fixture_contract": [
    "restricted and silenced are separate active Stable fixture sessions with empty response queues",
    "the restricted account is not a member of the configured #osu or #announce channel before the case",
    "the unrestricted restricted-message observer is already in that channel with an empty response queue",
    "the configured #osu or #announce channel exists with unrestricted read permission on both targets, so the restricted account cannot read or join it",
    "the silenced account is already joined to its public channel and has at least sixty seconds left on its silence",
    "the silenced peer is online, joined to that public channel and has an empty response queue before each probe",
    "all fixture ids, usernames, stats and channel visibility match across targets"
  ],
  "requires": [
    "stable_restricted_token",
    "stable_restricted_user_id",
    "stable_restricted_observer_token",
    "stable_restricted_observer_user_id",
    "stable_restricted_channel",
    "stable_silenced_token",
    "stable_silenced_user_id",
    "stable_silenced_username",
    "stable_silenced_public_channel",
    "stable_silenced_peer_username",
    "stable_silenced_peer_token",
    "stable_silenced_peer_user_id"
  ],
  "session_bindings": [
    { "token": "stable_restricted_token", "user_id": "stable_restricted_user_id" },
    { "token": "stable_restricted_observer_token", "user_id": "stable_restricted_observer_user_id" },
    { "token": "stable_silenced_token", "user_id": "stable_silenced_user_id" },
    { "token": "stable_silenced_peer_token", "user_id": "stable_silenced_peer_user_id" }
  ],
  "coverage": {
    "client_packets": [1, 3, 4, 16, 25, 30, 63, 78, 79, 85],
    "routes": []
  },
