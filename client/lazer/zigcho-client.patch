+            };
+
+            User.BindValueChanged(userChanged, true);
+        }
+
+        private void userChanged(ValueChangedEvent<UserProfileData?> user)
+        {
+            content.Clear();
+
+            APIUserAchievement[] achievements = user.NewValue?.User.Achievements ?? [];
+            if (achievements.Length == 0)
+                return;
+
+            APIUserAchievement[] recent = achievements.OrderByDescending(achievement => achievement.AchievedAt).Take(8).ToArray();
+            content.Add(new MedalGroup("recent", recent, true));
+
+            foreach (var group in achievements.GroupBy(achievement => achievement.Grouping)
+                                              .OrderBy(group => group.Key))
+            {
+                content.Add(new MedalGroup(
+                    string.IsNullOrEmpty(group.Key) ? "achievements" : group.Key,
+                    group.OrderBy(achievement => achievement.Ordering)
+                         .ThenBy(achievement => achievement.ID)
+                         .ToArray(),
+                    false));
+            }
+        }
+
+        private partial class MedalGroup : FillFlowContainer
+        {
+            public MedalGroup(string title, APIUserAchievement[] achievements, bool recent)
+            {
+                RelativeSizeAxes = Axes.X;
+                AutoSizeAxes = Axes.Y;
+                Direction = FillDirection.Vertical;
+                Spacing = new Vector2(0, 10);
+
+                Add(new GroupHeader(title));
+                Add(new FillFlowContainer
+                {
+                    RelativeSizeAxes = Axes.X,
+                    AutoSizeAxes = Axes.Y,
+                    Direction = FillDirection.Full,
+                    Spacing = new Vector2(recent ? 14 : 20, 10),
+                    Children = achievements.Select(achievement => new MedalEntry(achievement, recent)).ToArray(),
+                });
+            }
+        }
+
+        private partial class GroupHeader : CompositeDrawable
+        {
+            public GroupHeader(string title)
+            {
+                RelativeSizeAxes = Axes.X;
+                Height = 26;
+
+                InternalChildren = new Drawable[]
+                {
+                    new Box
+                    {
+                        RelativeSizeAxes = Axes.X,
+                        Height = 2,
+                        Colour = new Colour4(237, 131, 182, 255),
+                    },
+                    new OsuSpriteText
+                    {
+                        Y = 8,
+                        Text = title,
+                        Font = OsuFont.GetFont(size: 15, weight: FontWeight.Bold),
+                    },
+                };
+            }
+        }
+
+        private partial class MedalEntry : CompositeDrawable, IHasTooltip
+        {
+            public LocalisableString TooltipText { get; }
+
+            public MedalEntry(APIUserAchievement achievement, bool recent)
+            {
+                Width = recent ? 88 : 70;
+                Height = recent ? 95 : 76;
+                TooltipText = $"{achievement.Grouping}\n{achievement.Name}\n{achievement.Description}\nachieved {achievement.AchievedAt.LocalDateTime:d}";
+
+                InternalChild = new DelayedLoadWrapper(new AchievementIcon(achievement.IconUrl)
+                {
+                    RelativeSizeAxes = Axes.Both,
+                    FillMode = FillMode.Fit,
+                })
+                {
+                    RelativeSizeAxes = Axes.Both,
+                };
+            }
+        }
+
+        [LongRunningLoad]
+        private partial class AchievementIcon : Container
+        {
+            private readonly string url;
+            private readonly Sprite sprite;
+
+            public AchievementIcon(string url)
+            {
+                this.url = url;
+                Child = sprite = new Sprite
+                {
+                    RelativeSizeAxes = Axes.Both,
+                    Anchor = Anchor.Centre,
+                    Origin = Anchor.Centre,
+                };
+            }
+
+            [BackgroundDependencyLoader]
+            private void load(LargeTextureStore textures)
+            {
+                sprite.Texture = textures.Get(url);
+            }
+        }
     }
 }
